<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.Daniel_v8.Ohmega</id>
  <name>Ohmega</name>
  <summary>Normalize audio loudness directly in your files</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>GPL-3.0-only</project_license>

  <description>
    <p>
      Ohmega normalizes the loudness of your audio files using the EBU R128 standard.
      Unlike ReplayGain tags, Ohmega writes the gain directly into the audio data —
      so your files play at the correct volume in every player without any configuration.
    </p>
    <p>Features:</p>
    <ul>
      <li>Drag and drop files or entire folders</li>
      <li>Supports FLAC, WAV, MP3, OGG, OPUS, M4A, AAC, WMA, APE, WavPack</li>
      <li>Lossless processing for FLAC, WAV, AIFF, APE and WavPack</li>
      <li>Automatic backup of originals before modifying</li>
      <li>Three loudness targets: Streaming (−14 LUFS), ReplayGain (−18 LUFS), Broadcast/Film (−23 LUFS)</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.Daniel_v8.Ohmega.desktop</launchable>

